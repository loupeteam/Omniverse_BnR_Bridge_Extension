[package]
title = "BR bridge fix check"
version = "0.1.0"
description = "Headless app that loads the B&R extension and the PLC bridge framework for tools/kit_check/kit_check.py."
keywords = ["experience", "app", "usd"]
template_name = "omni.usd_composer"

# Copied from Omni-Utils tools/kit_check. run.sh / run.ps1 generate the .kit
# from this template: ${FIXCHECK_EXTS} becomes the extension folder under test,
# ${FIXCHECK_BRIDGE_EXTS} the folder holding loupe.simulation.bridge (Omni-Utils
# exts/) and ${FIXCHECK_KIT_ROOT} the kit-app-template build (the folder holding
# kit/kit.exe). Kit resolves ${app} to the generated
# file's folder, which is a temp dir, so the build's folders are named in full.
#
# The dependency list is the kit-app-template USD Composer app with the project
# extensions removed: everything the bridge touches (omni.usd, omni.timeline,
# the menu utils, the stage and property windows the mirror is inspected with)
# resolves from the build's extscache.

[dependencies]
# --- shell ---
"omni.kit.uiapp" = {}
"omni.kit.renderer.core" = {}
"omni.kit.window.title" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.console" = {}
"omni.kit.window.extensions" = {}
"omni.kit.window.script_editor" = {}

# --- menus ---
"omni.kit.menu.utils" = {}
"omni.kit.menu.file" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.create" = {}
"omni.kit.menu.stage" = {}
"omni.kit.menu.common" = { order = 1000 }

# --- viewport ---
"omni.kit.viewport.bundle" = {}
"omni.kit.viewport.rtx" = {}
"omni.kit.viewport.actions" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.transform" = {}

# --- stage authoring ---
"omni.usd" = {}
"omni.kit.window.file" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.property" = {}
"omni.kit.property.bundle" = {}
"omni.kit.stage_templates" = {}
"omni.kit.selection" = {}
"omni.kit.context_menu" = {}

# --- physics ---
"omni.usdphysics" = {}
"omni.physx" = {}
"omni.physx.stageupdate" = {}
"omni.timeline" = {}

# --- the extension under test ---
# Declared rather than passed with --enable so Kit resolves the load order
# itself; it pulls in loupe.simulation.bridge through its own dependency.
"loupe.simulation.br_bridge" = {}

[settings.app]
name = "BR bridge fix check"
content.emptyStageOnStart = false
fastShutdown = true
useFabricSceneDelegate = false

[settings.app.window]
title = "BR bridge fix check"
width = 1920
height = 1080

[settings.app.extensions]
registryEnabled = true

# The bridge is configured by the stage: prims under /PLC carrying bridge:driver
# and the driver's options (or the 0.3.0rc1 br_bridge:* attributes). kit_check.py
# enables communication itself, so the stage ships Enable = false.

[settings.app.exts.folders]
'++' = [
    "${FIXCHECK_KIT_ROOT}/exts",
    "${FIXCHECK_KIT_ROOT}/extscache",
    "${FIXCHECK_KIT_ROOT}/apps",
    "${FIXCHECK_EXTS}",
    "${FIXCHECK_BRIDGE_EXTS}",
]

[settings.exts."omni.kit.pipapi"]
# The framework installs plc-bridge from its own wheels/ folder, which only a
# packaged build fills (Omni-Utils tools/build_wheels.py). The B&R extension's
# wheels/ (tools/build_wheels.py here) carries plc-bridge as well, since
# br-bridge needs it; naming it app-wide lets the framework, which starts
# first, install from it too, so the read-only Omni-Utils checkout needs no
# build step.
archiveDirs = ["${FIXCHECK_EXTS}/loupe.simulation.br_bridge/wheels"]

[settings.app.viewport]
autoFrame.mode = "first_open"
defaults.fillViewport = true

[settings.app.renderer]
resolution.width = 1920
resolution.height = 1080
skipWhileMinimized = true

[settings]
renderer.active = "rtx"
renderer.enabled = "rtx"
foundation.verifyOsVersion.enabled = false

[settings.rtx]
ecoMode.enabled = true

[settings.persistent.app.viewport]
displayOptions = 32255

[template]
type = "ApplicationTemplate"
